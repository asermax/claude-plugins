filters:
  and:
    - file.hasTag("<<TAG>>")
    - not:
        - file.hasTag("index")
    - not:
        - file.inFolder("_templates")
properties:
  file.name:
    displayName: Note
  note.summary:
    displayName: <<EXPLAINS>>
views:
  - type: table
    name: Notes
    order:
      - file.name
      - note.summary
    sort:
      - property: file.name
        direction: ASC
